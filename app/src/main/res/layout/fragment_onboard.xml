<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_splash">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_main"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/layoutBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/_24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Page Indicator Simulated -->
        <LinearLayout
            android:id="@+id/layoutIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_24dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/btnGetStarted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:layout_width="@dimen/_16dp"
                android:layout_height="@dimen/_4dp"
                android:background="@drawable/bg_radius_4_stroke_blue"
                android:backgroundTint="@color/purple_primary" />

            <View
                android:layout_width="@dimen/_4dp"
                android:layout_height="@dimen/_4dp"
                android:layout_marginStart="@dimen/_4dp"
                android:background="@drawable/bg_rounded"
                android:backgroundTint="@color/bg_category_unselected" />

            <View
                android:layout_width="@dimen/_4dp"
                android:layout_height="@dimen/_4dp"
                android:layout_marginStart="@dimen/_4dp"
                android:background="@drawable/bg_rounded"
                android:backgroundTint="@color/bg_category_unselected" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_56dp"
            android:layout_marginHorizontal="@dimen/_24dp"
            android:backgroundTint="@color/purple_primary"
            android:fontFamily="@font/font_700"
            android:text="@string/get_started"
            android:textColor="@color/black"
            android:textSize="@dimen/_14sp"
            app:cornerRadius="@dimen/_28dp"
            app:icon="@drawable/ic_next"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/_8dp"
            app:iconTint="@color/black"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
