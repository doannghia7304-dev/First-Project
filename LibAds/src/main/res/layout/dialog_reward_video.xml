<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="#4D000000">

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_radius_12"
        android:backgroundTint="@color/white"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.85">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:gravity="center"
            android:text="@string/you_need_to_watch_an_ad_to_do_this_action"
            android:textColor="@color/black"
            android:textSize="@dimen/_16sp" />

        <TextView
            android:id="@+id/btnWatchAds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:background="@drawable/bg_radius_10"
            android:backgroundTint="@color/gray_a2"
            android:gravity="center"
            android:paddingVertical="@dimen/_8dp"
            android:text="@string/watch_ads"
            android:textColor="@color/white"
            android:textSize="@dimen/_16dp" />

        <TextView
            android:id="@+id/btnBuyIap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:background="@drawable/bg_radius_10"
            android:backgroundTint="@color/gray_a2"
            android:gravity="center"
            android:paddingVertical="@dimen/_8dp"
            android:text="@string/buy_premium"
            android:textColor="@color/white"
            android:textSize="@dimen/_16dp" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:background="@drawable/bg_radius_10"
            android:backgroundTint="@color/gray_a2"
            android:gravity="center"
            android:paddingVertical="@dimen/_8dp"
            android:text="@string/cancel"
            android:textColor="@color/white"
            android:textSize="@dimen/_16dp" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>