<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:tag="fullscreen">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/adViewHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_ads"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10dp"
            android:background="@drawable/bg_ad_tag_top_right"
            android:backgroundTint="#FFA800"
            android:fontFamily="@font/font_500"
            android:paddingHorizontal="@dimen/_4dp"
            android:paddingVertical="@dimen/_2dp"
            android:text="@string/ad_attribution"
            android:textColor="@color/white"
            android:textSize="@dimen/_12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_154dp"
            android:background="@color/white"
            android:paddingHorizontal="@dimen/_16dp"
            android:paddingTop="@dimen/_20dp"
            android:paddingBottom="@dimen/_12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginEnd="@dimen/_10dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@+id/ad_call_to_action"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ad_call_to_action"
                app:layout_constraintTop_toTopOf="@+id/ad_call_to_action">

                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/font_600"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_16sp"
                    tools:text="Duck Adventure App" />

                <TextView
                    android:id="@+id/ad_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/font_500"
                    android:lineSpacingExtra="@dimen/_4dp"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sp"
                    tools:text="Đây là mô tả của đoạn quảng cáo này có thể xuống tới 2 dòng dài như thế này này hehehe haha ha" />


            </LinearLayout>


            <TextView
                android:id="@+id/ad_call_to_action"
                android:layout_width="@dimen/_100dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_radius_10"
                android:backgroundTint="#3ADB41"
                android:fontFamily="@font/font_700"
                android:gravity="center"
                android:paddingVertical="@dimen/_12dp"
                android:textAlignment="center"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="100:46"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="OPEN" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>